{
  "name": "raco",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "deploy": "turbo run deploy -F @raco/alchemy",
    "destroy": "turbo run destroy -F @raco/alchemy",
    "dev": "turbo run dev -F @raco/alchemy",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.10.11"
  },
  "packageManager": "bun@1.4.0",
  "catalogs": {
    "dev": {
      "@types/bun": "^1.4.0",
      "tsdown": "^0.22.14",
      "typescript": "^7.0.2"
    },
    "prod": {
      "alchemy": "^2.0.0-beta.74"
    },
    "effect": {
      "@effect/platform-bun": "^4.0.0-rc.111",
      "@effect/platform-node": "^4.0.0-rc.111",
      "@effect/sql-pg": "^4.0.0-rc.111",
      "effect": "^4.0.0-rc.111"
    },
    "react": {
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5",
      "react": "^19.2.8",
      "react-dom": "^19.2.8"
    }
  }
}
